// Zed 디버거 설정. 명령 팔레트에서 `debug: start` 를 실행하면 이 목록이 뜬다.
//
// 시작하는 법
//   1. 멈추고 싶은 줄의 줄번호 왼쪽을 클릭해서 중단점을 찍는다 (F9 도 같다).
//   2. 명령 팔레트 → `debug: start` → 아래 항목 중 하나를 고른다.
//   3. 끝나면 Shift+F5 로 세션을 반드시 종료한다. 종료하지 않으면 세션이 쌓인다.
//
// stopOnEntry 를 쓰지 않는 이유
//   CodeLLDB 의 entry 는 main 이 아니라 libc 의 _start 다. 거기에는 대응하는
//   소스 파일이 없어서 편집기에 멈춘 줄이 표시되지 않고, Step Over 를 눌러도
//   화면에 아무 변화가 없는 것처럼 보인다. 중단점을 직접 찍는 편이 확실하다.
//   GDB 어댑터에는 main 에서 멈추는 stopAtBeginningOfMainSubprogram 이 있다.
//
// scanf 메뉴 루프가 있는 Q1_A_LL 은 키보드 입력이 필요하다.
// 입력을 받으려면 터미널을 붙여 주는 CodeLLDB 항목을 쓴다.
[
  {
    "label": "Q1_A_LL (CodeLLDB, 입력 파일 고정)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "make Q1_A_LL",
      "cwd": "/home/benjohnbill/dev/krafton-jungle/week04"
    },
    "program": "/home/benjohnbill/dev/krafton-jungle/week04/build/Q1_A_LL",
    "cwd": "/home/benjohnbill/dev/krafton-jungle/week04",
    // CodeLLDB 의 stdio 옵션은 이 조합에서 무시된다 (DAP 로 직접 확인함).
    // 대신 lldb 설정을 preRunCommands 로 직접 준다. 이쪽은 실제로 먹는다.
    // terminal 을 console 로 둬야 Windows ConPTY 터미널을 열지 않는다.
    // 입력을 바꾸려면 scratch/q1-input.txt 를 고친다. 마지막 줄은 0 (Quit) 로.
    "terminal": "console",
    "preRunCommands": [
      "settings set target.input-path /home/benjohnbill/dev/krafton-jungle/week04/scratch/q1-input.txt"
    ]
  },
  {
    "label": "Q1_A_LL (CodeLLDB, 터미널 입력 파이프)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "make Q1_A_LL",
      "cwd": "/home/benjohnbill/dev/krafton-jungle/week04"
    },
    "program": "/home/benjohnbill/dev/krafton-jungle/week04/build/Q1_A_LL",
    "cwd": "/home/benjohnbill/dev/krafton-jungle/week04",
    // 손으로 메뉴를 입력하면서 GUI 디버거를 쓰고 싶을 때 쓴다.
    // 순서가 중요하다. WSL 터미널 탭에서 scratch/dbg-stdin.sh 를 먼저 실행하고,
    // 그 다음에 이 세션을 시작한다. 스크립트가 /tmp/q1-stdin 파이프를 만든다.
    // 파이프가 없으면 프로그램이 시작하지 못하고 그대로 대기한다.
    //
    // 프로그램 출력은 Zed 의 디버그 콘솔에 나오고, 입력은 파이프 창에 친다.
    "terminal": "console",
    "preRunCommands": [
      "settings set target.input-path /tmp/q1-stdin"
    ]
  },
  {
    "label": "Q1_A_LL (GDB, main 에서 자동 정지)",
    "adapter": "GDB",
    "request": "launch",
    "build": {
      "command": "make Q1_A_LL",
      "cwd": "/home/benjohnbill/dev/krafton-jungle/week04"
    },
    "program": "/home/benjohnbill/dev/krafton-jungle/week04/build/Q1_A_LL",
    "cwd": "/home/benjohnbill/dev/krafton-jungle/week04",
    "stopAtBeginningOfMainSubprogram": true
  },
  {
    "label": "play1 (CodeLLDB, 터미널 입력)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "make play1",
      "cwd": "/home/benjohnbill/dev/krafton-jungle/week04"
    },
    "program": "/home/benjohnbill/dev/krafton-jungle/week04/build/play1",
    "cwd": "/home/benjohnbill/dev/krafton-jungle/week04",
    "terminal": "integrated"
  },
  {
    "label": "play1 (GDB, main 에서 자동 정지)",
    "adapter": "GDB",
    "request": "launch",
    "build": {
      "command": "make play1",
      "cwd": "/home/benjohnbill/dev/krafton-jungle/week04"
    },
    "program": "/home/benjohnbill/dev/krafton-jungle/week04/build/play1",
    "cwd": "/home/benjohnbill/dev/krafton-jungle/week04",
    "stopAtBeginningOfMainSubprogram": true
  }
]
